# Copy this file to .env for local configuration.
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional: enables AI-written explanations on top of the local auction-activity signal.
# The app works without a key and never exposes this value to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
